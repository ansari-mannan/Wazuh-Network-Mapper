# Python
__pycache__/
*.pyc
.pytest_cache/

# virtual environments
.venv/
venv/
env/

# env files (backend/.env.example is the committed template)
.env
.env.*
!.env.example

# scanner working files
agents.json
scored_agents.json
.local/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# data/graph.json, vulnerabilities.json and attack_paths.json are a committed
# synthetic sample (backend/scripts/make_sample_data.py); a real scan into
# data/ overwrites them, so do not commit them after one.
# the owner's own list of important assets for the exposure-path stage
# (targets.example.json / targets.sample.json are the committed templates)
data/targets.json
# NVD answers kept between scans (devicecves)
data/nvd-cache.json
# what nmap found per host, reused for 24 h (servicescan)
data/nmap-cache.json
# the scan schedule (plugin: the choice and the last scheduled run)
data/schedule.json
# scan history: copies of each scan's files (MACs, serials) and their index
data/history/
# the liveness check's last state (plugin, vulnmapper.liveness)
data/liveness.json
# the recommendations tracker (plugin)
data/recommendations.json
# CVE records and the KEV / EPSS feeds cached by a scan or the feeds refresh
data/cve-records.json
data/kev.json
data/epss_scores-current.csv.gz
# temp files of an interrupted write: the plugin's <name>.tmp-<pid>[-<n>] and
# the scanner's .<name>.<random>.tmp
data/*.tmp-*
data/.*.tmp

# Serena (editor agent) project files
.serena/
