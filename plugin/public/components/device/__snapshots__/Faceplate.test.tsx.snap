exports[`Faceplate unknown device with only port_status: a plain panel, PWR off when SNMP did not answer 1`] = `
"<div>
<div class=\\"vmFp\\" style=\\"--vm-route: #BD271E;\\">
<div class=\\"vmFpStripWrap\\">
<div class=\\"vmFpStrip\\" data-test-subj=\\"vmFaceplateStrip\\">
<svg class=\\"vmFaceplate vmFaceplate--generic\\" viewBox=\\"0 0 130.34 77\\" width=\\"100%\\" style=\\"max-width: 162.925px;\\" role=\\"group\\" aria-label=\\"unknown front panel\\" data-test-subj=\\"vmFaceplate\\">
<defs>
<linearGradient id=\\"X\\" x1=\\"0\\" y1=\\"0\\" x2=\\"0\\" y2=\\"1\\">
<stop offset=\\"0\\" class=\\"vmFpGradTop\\">
</stop>
<stop offset=\\"0.3\\" class=\\"vmFpGradBody\\">
</stop>
</linearGradient>
</defs>
<rect class=\\"vmFpChassis\\" x=\\"1\\" y=\\"1\\" width=\\"128.34\\" height=\\"75\\" rx=\\"4\\" stroke-width=\\"2\\" fill=\\"url(#vmFpGrad-deviceunknown)\\">
</rect>
<rect class=\\"vmFpPlate\\" x=\\"10\\" y=\\"5\\" width=\\"43.28\\" height=\\"14\\" rx=\\"2\\">
