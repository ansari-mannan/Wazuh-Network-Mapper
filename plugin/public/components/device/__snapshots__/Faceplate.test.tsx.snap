exports[`Faceplate in a measured card HP 1920-48G (1-52) in 560 px: one strip with full detail, ports >= 22 px, scrolling, Expand 1`] = `
"<div>
<div class=\\"vmFp\\" style=\\"--vm-route: #BD271E;\\">
