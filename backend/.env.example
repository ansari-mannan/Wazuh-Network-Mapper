# The scanner's credentials. Copy this file to ~/.vulnmapper.env (scripts/run.sh
# loads it before starting the dashboard, whose scans pass it on to the scanner),
# or set the same variables in the shell to run python -m vulnmapper directly.

# --- Wazuh Manager API (endpoint collection) ---
# Manager API host (the code default)
WAZUH_HOST=localhost
# Manager API port (the code default)
WAZUH_PORT=55000
# Manager API user (the code default)
WAZUH_USER=wazuh-wui
# Manager API password; required when endpoints are collected
WAZUH_PASS=
# Optional path to a CA bundle for verifying the Manager API certificate
WAZUH_CA_BUNDLE=

# --- Wazuh Indexer (CVE scoring) ---
# Indexer host (the code default)
INDEXER_HOST=192.168.100.2
# Indexer port (the code default)
INDEXER_PORT=9200
# Indexer user (the code default)
INDEXER_USER=admin
# Indexer password; required when endpoints are scored
INDEXER_PASS=
# Optional path to a CA bundle for verifying the Indexer certificate
INDEXER_CA_BUNDLE=

# --- TLS ---
# Set to true to verify TLS certificates when no CA bundle is given (default: off)
VULNMAPPER_VERIFY_TLS=

# --- SNMP (network crawl); at least one community or a v3 user is required ---
# SNMPv2c communities to try, comma or space separated
SNMP_COMMUNITIES=
# A single SNMPv2c community (alternative to SNMP_COMMUNITIES)
SNMP_COMMUNITY=
# SNMPv3 user name; enables a v3 credential when set
SNMP_V3_USER=
# SNMPv3 authentication protocol
SNMP_V3_AUTH_PROTO=
# SNMPv3 authentication key
SNMP_V3_AUTH_KEY=
# SNMPv3 privacy protocol
SNMP_V3_PRIV_PROTO=
# SNMPv3 privacy key
SNMP_V3_PRIV_KEY=

# --- NVD (CVE lookups for network devices) ---
# Optional NVD API key: NVD then allows requests 0.8 s apart instead of 6 s
NVD_API_KEY=
